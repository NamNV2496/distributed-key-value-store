{
  "info": {
    "name": "go-redis-raft",
    "description": "All commands for the go-redis-raft distributed key-value store.\nImport this file into Postman, then set the `base_url` collection variable to point at any node (e.g. http://localhost:8000). The client-service auto-discovers the leader.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "raft_url",
      "value": "http://localhost:5000",
      "type": "string",
      "description": "Direct Raft node URL — use when calling /raft/* endpoints without the client-service"
    }
  ],
  "item": [
    {
      "name": "String / Key",
      "item": [
        {
          "name": "PING",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cmd\": \"PING\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/redis", "host": ["{{base_url}}"], "path": ["redis"] }
          }
        },
        {
          "name": "PING with message",
